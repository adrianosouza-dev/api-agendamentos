# Copie este arquivo para ".env" e ajuste os valores. O .env NUNCA vai para o GitHub.

# Banco: SQLite local. Em produção, cole a URL do Postgres (ex.: Supabase).
DATABASE_URL=sqlite:///./agendamentos.db

# Gere uma chave aleatória com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao
TOKEN_EXPIRA_MINUTOS=60

# Admin criado automaticamente na primeira execução
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha

# Funcionamento da barbearia
FUSO_HORARIO=America/Sao_Paulo
HORA_ABERTURA=09:00
HORA_FECHAMENTO=19:00
INTERVALO_MINUTOS=30
# 0 = segunda ... 6 = domingo
DIAS_FUNCIONAMENTO=0,1,2,3,4,5

# Sites que podem chamar a API pelo navegador, separados por vírgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
